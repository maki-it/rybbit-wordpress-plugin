#. Plugin Name of the plugin
#: integrate-rybbit.php admin/class-integrate-rybbit-admin.php:47
#: admin/class-integrate-rybbit-admin.php:48
#: admin/class-integrate-rybbit-admin.php:610
msgid "Integrate Rybbit"
msgstr "Integrate Rybbit"

#. Plugin URI of the plugin
#: integrate-rybbit.php
msgid "https://wordpress.org/plugins/integrate-rybbit/"
msgstr "https://wordpress.org/plugins/integrate-rybbit/"

#. Description of the plugin
#: integrate-rybbit.php
msgid "Add and manage the Rybbit Analytics tracking script."
msgstr "Das Rybbit-Analytics-Tracking-Skript hinzufügen und verwalten."

#. Author of the plugin
#: integrate-rybbit.php
msgid "Maki IT"
msgstr "Maki IT"

#. Author URI of the plugin
#: integrate-rybbit.php
msgid "https://maki-it.de"
msgstr "https://maki-it.de"

#: admin/class-integrate-rybbit-admin.php:65
msgid "Settings"
msgstr "Einstellungen"

#: admin/class-integrate-rybbit-admin.php:163
msgid "Site ID is required."
msgstr "Die Site-ID ist erforderlich."

#: admin/class-integrate-rybbit-admin.php:186
msgid "Script URL is required."
msgstr "Die Skript-URL ist erforderlich."

#: admin/class-integrate-rybbit-admin.php:199
msgid "Script URL is not a valid URL."
msgstr "Die Skript-URL ist keine gültige URL."

#: admin/class-integrate-rybbit-admin.php:209
msgid "Script URL must use HTTPS."
msgstr "Die Skript-URL muss HTTPS verwenden."

#: admin/class-integrate-rybbit-admin.php:245
msgid "The API key has invalid characters or a wrong length. It was not saved."
msgstr ""
"Der API-Schlüssel enthält ungültige Zeichen oder hat eine falsche Länge. Er "
"wurde nicht gespeichert."

#: admin/class-integrate-rybbit-admin.php:270
msgid ""
"The API URL must be a valid HTTPS URL. HTTP works only for local hosts. It "
"was not saved."
msgstr ""
"Die API-URL muss eine gültige HTTPS-URL sein. HTTP funktioniert nur für "
"lokale Hosts. Sie wurde nicht gespeichert."

#. translators: 1: number of dropped rules, 2: maximum number of rules
#: admin/class-integrate-rybbit-admin.php:316
#, php-format
msgid ""
"%1$d custom event rule was not saved. A rule needs a valid selector, an "
"event name and properties as \"key=value\" lines. You can save at most %2$d "
"rules."
msgid_plural ""
"%1$d custom event rules were not saved. A rule needs a valid selector, an "
"event name and properties as \"key=value\" lines. You can save at most %2$d "
"rules."
msgstr[0] ""
"%1$d Event-Regel wurde nicht gespeichert. Eine Regel braucht einen gültigen "
"Selektor, einen Eventnamen und Eigenschaften als Zeilen im Format "
"„key=value“. Es können höchstens %2$d Regeln gespeichert werden."
msgstr[1] ""
"%1$d Event-Regeln wurden nicht gespeichert. Eine Regel braucht einen "
"gültigen Selektor, einen Eventnamen und Eigenschaften als Zeilen im Format "
"„key=value“. Es können höchstens %2$d Regeln gespeichert werden."

#: admin/class-integrate-rybbit-admin.php:416
msgid "Invalid slimDOM options. Use true, false or a JSON object."
msgstr ""
"Ungültige slimDOM-Optionen. Zulässig sind true, false oder ein JSON-Objekt."

#: admin/class-integrate-rybbit-admin.php:417
msgid ""
"Invalid JSON. Please provide a JSON object (example: {\"password\":true,"
"\"email\":true})."
msgstr ""
"Ungültiges JSON. Bitte ein JSON-Objekt angeben (Beispiel: {\"password\":true,"
"\"email\":true})."

#: admin/class-integrate-rybbit-admin.php:469
msgid "Tracking"
msgstr "Tracking"

#: admin/class-integrate-rybbit-admin.php:470
msgid "Privacy"
msgstr "Datenschutz"

#: admin/class-integrate-rybbit-admin.php:471
msgid "Script Attributes"
msgstr "Skript-Attribute"

#: admin/class-integrate-rybbit-admin.php:472
msgid "Custom Events"
msgstr "Eigene Events"

#: admin/class-integrate-rybbit-admin.php:473
msgid "Session Replay"
msgstr "Session Replay"

#: admin/class-integrate-rybbit-admin.php:474
msgid "Dashboard"
msgstr "Dashboard"

#: admin/class-integrate-rybbit-admin.php:475
msgid "Maintenance"
msgstr "Wartung"

#: admin/class-integrate-rybbit-admin.php:476
msgid "Debug"
msgstr "Debug"

#: admin/class-integrate-rybbit-admin.php:477
msgid "About"
msgstr "Über"

#: admin/class-integrate-rybbit-admin.php:509
msgid "Reset to defaults"
msgstr "Auf Standardwerte zurücksetzen"

#: admin/class-integrate-rybbit-admin.php:611
msgid "Configure tracking and privacy settings for the Rybbit tracking script."
msgstr ""
"Tracking- und Datenschutzeinstellungen für das Rybbit-Tracking-Skript "
"konfigurieren."

#: admin/class-integrate-rybbit-admin.php:615
msgid "Integrate Rybbit settings"
msgstr "Integrate-Rybbit-Einstellungen"

#: admin/class-integrate-rybbit-admin.php:662
msgid "Site ID"
msgstr "Site-ID"

#: admin/class-integrate-rybbit-admin.php:675
msgid "Find this in your Rybbit dashboard under your site's tracking settings."
msgstr ""
"Zu finden im Rybbit-Dashboard unter den Tracking-Einstellungen der Website."

#: admin/class-integrate-rybbit-admin.php:680
msgid "Script URL"
msgstr "Skript-URL"

#. translators: %s: Example script URL.
#: admin/class-integrate-rybbit-admin.php:698
#, php-format
msgid "Example: %s"
msgstr "Beispiel: %s"

#: admin/class-integrate-rybbit-admin.php:706
msgid "Do not track these roles"
msgstr "Diese Rollen nicht tracken"

#: admin/class-integrate-rybbit-admin.php:713
msgid ""
"Selected roles will not receive the tracking script (frontend and wp-admin)."
msgstr ""
"Ausgewählte Rollen erhalten das Tracking-Skript nicht (Frontend und wp-"
"admin)."

#: admin/class-integrate-rybbit-admin.php:717
msgid "Script loading"
msgstr "Laden des Skripts"

#: admin/class-integrate-rybbit-admin.php:720
msgid "Defer (recommended)"
msgstr "Defer (empfohlen)"

#: admin/class-integrate-rybbit-admin.php:721
msgid "Async"
msgstr "Async"

#. translators: 1: Code word defer. 2: Code word async.
#: admin/class-integrate-rybbit-admin.php:727
#, php-format
msgid "Controls whether the tracking script tag uses %1$s (default) or %2$s."
msgstr ""
"Legt fest, ob das Tracking-Skript-Tag %1$s (Standard) oder %2$s verwendet."

#: admin/class-integrate-rybbit-admin.php:736
msgid "wp-admin"
msgstr "wp-admin"

#: admin/class-integrate-rybbit-admin.php:738
msgid "Also load the tracking script in wp-admin"
msgstr "Tracking-Skript auch in wp-admin laden"

#: admin/class-integrate-rybbit-admin.php:739
msgid ""
"Off by default. Most sites only need frontend tracking. Excluded roles are "
"never tracked."
msgstr ""
"Standardmäßig aus. Die meisten Websites brauchen nur Tracking im Frontend. "
"Ausgeschlossene Rollen werden nie getrackt."

#: admin/class-integrate-rybbit-admin.php:754
msgid "WordPress scoped (default)"
msgstr "WordPress mit Site-Präfix (Standard)"

#: admin/class-integrate-rybbit-admin.php:755
msgid "Keyed hash (HMAC, hides the WordPress user ID)"
msgstr "Schlüsselbasierter Hash (HMAC, verbirgt die WordPress-Benutzer-ID)"

#: admin/class-integrate-rybbit-admin.php:756
msgid "WordPress user ID (numeric)"
msgstr "WordPress-Benutzer-ID (numerisch)"

#: admin/class-integrate-rybbit-admin.php:757
msgid "Username (user_login)"
msgstr "Benutzername (user_login)"

#: admin/class-integrate-rybbit-admin.php:758
msgid "Email address"
msgstr "E-Mail-Adresse"

#: admin/class-integrate-rybbit-admin.php:759
msgid "Custom user meta value"
msgstr "Benutzerdefinierter User-Meta-Wert"

#: admin/class-integrate-rybbit-admin.php:764
msgid "Identify logged-in users"
msgstr "Angemeldete Benutzer identifizieren"

#: admin/class-integrate-rybbit-admin.php:767
msgid "Disabled"
msgstr "Deaktiviert"

#: admin/class-integrate-rybbit-admin.php:768
msgid "Pseudonymized (hashed)"
msgstr "Pseudonymisiert (gehasht)"

#: admin/class-integrate-rybbit-admin.php:769
msgid "Full (cleartext email)"
msgstr "Vollständig (E-Mail im Klartext)"

#: admin/class-integrate-rybbit-admin.php:772
msgid "GDPR/Privacy:"
msgstr "DSGVO/Datenschutz:"

#: admin/class-integrate-rybbit-admin.php:773
msgid ""
"Identifying users is personal data processing. Only enable this if you have "
"a lawful basis (e.g. consent) and have updated your privacy policy and "
"consent banner accordingly."
msgstr ""
"Das Identifizieren von Benutzern ist eine Verarbeitung personenbezogener "
"Daten. Dies sollte nur aktiviert werden, wenn eine Rechtsgrundlage (z. B. "
"Einwilligung) vorliegt und die Datenschutzerklärung sowie das "
"Einwilligungsbanner entsprechend angepasst sind."

#: admin/class-integrate-rybbit-admin.php:778
msgid "User ID used for identification"
msgstr "Für die Identifikation verwendete Benutzer-ID"

#. translators: %s: "userId".
#: admin/class-integrate-rybbit-admin.php:790
#, php-format
msgid ""
"Controls what is sent as the Rybbit %s when identifying logged-in users."
msgstr ""
"Legt fest, was beim Identifizieren angemeldeter Benutzer als Rybbit-%s "
"gesendet wird."

#. translators: 1: strategy name, 2: example userId.
#: admin/class-integrate-rybbit-admin.php:799
#, php-format
msgid ""
"%1$s sends the site ID and the user ID, for example %2$s. The value stays "
"the same for each user. It shows the WordPress user ID."
msgstr ""
"%1$s sendet die Site-ID und die Benutzer-ID, zum Beispiel %2$s. Der Wert "
"bleibt für jeden Benutzer gleich. Er zeigt die WordPress-Benutzer-ID."

#: admin/class-integrate-rybbit-admin.php:800
msgid "WordPress scoped"
msgstr "WordPress mit Site-Präfix"

#. translators: 1: strategy name, 2: example userId.
#: admin/class-integrate-rybbit-admin.php:809
#, php-format
msgid ""
"%1$s sends a hash of the user ID, for example %2$s. It does not show the "
"WordPress user ID. The hash uses the security keys of this site. If you "
"change these keys, all users get a new ID in Rybbit."
msgstr ""
"%1$s sendet einen Hash der Benutzer-ID, zum Beispiel %2$s. Er zeigt nicht "
"die WordPress-Benutzer-ID. Der Hash verwendet die Sicherheitsschlüssel "
"dieser Website. Werden diese Schlüssel geändert, erhalten alle Benutzer eine "
"neue ID in Rybbit."

#: admin/class-integrate-rybbit-admin.php:810
msgid "Keyed hash"
msgstr "Schlüsselbasierter Hash"

#: admin/class-integrate-rybbit-admin.php:815
msgid ""
"Note: \"Username\" and \"Custom user meta value\" send the value in "
"cleartext, also in pseudonymized mode."
msgstr ""
"Hinweis: „Benutzername“ und „Benutzerdefinierter User-Meta-Wert“ senden den "
"Wert im Klartext, auch im pseudonymisierten Modus."

#: admin/class-integrate-rybbit-admin.php:819
msgid "User meta key"
msgstr "User-Meta-Schlüssel"

#: admin/class-integrate-rybbit-admin.php:825
msgid "e.g. customer_id"
msgstr "z. B. customer_id"

#: admin/class-integrate-rybbit-admin.php:830
msgid "The value of this user meta field will be used as the Rybbit userId."
msgstr "Der Wert dieses User-Meta-Felds wird als Rybbit-userId verwendet."

#: admin/class-integrate-rybbit-admin.php:835
msgid "Identify payload preview"
msgstr "Vorschau der Identify-Payload"

#: admin/class-integrate-rybbit-admin.php:839
msgid ""
"Preview of the identify payload that would be sent for the current logged-in "
"user."
msgstr ""
"Vorschau der Identify-Payload, die für den aktuell angemeldeten Benutzer "
"gesendet würde."

#: admin/class-integrate-rybbit-admin.php:840
msgid "Refresh preview"
msgstr "Vorschau aktualisieren"

#: admin/class-integrate-rybbit-admin.php:845
msgid "Visitor opt-out"
msgstr "Opt-out für Besucher"

#. translators: 1: Shortcode, 2: Block name.
#: admin/class-integrate-rybbit-admin.php:851
#, php-format
msgid ""
"Let visitors turn the tracking off. Add the shortcode %1$s or the block %2$s "
"to a page, for example your privacy policy."
msgstr ""
"Besucher können das Tracking ausschalten. Dafür den Shortcode %1$s oder den "
"Block %2$s auf einer Seite einfügen, zum Beispiel in der "
"Datenschutzerklärung."

#: admin/class-integrate-rybbit-admin.php:853
msgid "Rybbit Opt-out"
msgstr "Rybbit Opt-out"

#. translators: %s: Name of the storage entry, for example "disable-rybbit".
#: admin/class-integrate-rybbit-admin.php:861
#, php-format
msgid ""
"The choice is saved in the browser of the visitor under %s. It applies to "
"this website and this browser only."
msgstr ""
"Die Auswahl wird im Browser des Besuchers unter %s gespeichert. Sie gilt nur "
"für diese Website und diesen Browser."

#: admin/class-integrate-rybbit-admin.php:889
msgid "Skip patterns"
msgstr "Ausschlussmuster"

#: admin/class-integrate-rybbit-admin.php:893
msgid "One pattern per line. Matching URL paths will not be tracked."
msgstr "Ein Muster pro Zeile. Passende URL-Pfade werden nicht getrackt."

#: admin/class-integrate-rybbit-admin.php:895
msgid "Wildcards:"
msgstr "Platzhalter:"

#. translators: 1: Single asterisk wildcard. 2: Slash character. 3: Double asterisk wildcard.
#: admin/class-integrate-rybbit-admin.php:899
#, php-format
msgid ""
"%1$s matches within one path segment (does not cross %2$s). %3$s matches "
"across multiple segments (can include %2$s)."
msgstr ""
"%1$s passt innerhalb eines Pfadsegments (überschreitet kein %2$s). %3$s "
"passt über mehrere Segmente hinweg (kann %2$s enthalten)."

#: admin/class-integrate-rybbit-admin.php:907
msgid "Regular expressions:"
msgstr "Reguläre Ausdrücke:"

#. translators: 1: "re:", 2: Example pattern.
#: admin/class-integrate-rybbit-admin.php:911
#, php-format
msgid "Start a line with %1$s to use a regular expression, for example %2$s."
msgstr ""
"Mit %1$s am Zeilenanfang wird ein regulärer Ausdruck verwendet, zum Beispiel "
"%2$s."

#: admin/class-integrate-rybbit-admin.php:917
msgid "Examples:"
msgstr "Beispiele:"

#. translators: 1: Pattern, 2: Matching path, 3: Path that does not match.
#: admin/class-integrate-rybbit-admin.php:922
#: admin/class-integrate-rybbit-admin.php:926
#, php-format
msgid "%1$s matches %2$s but not %3$s"
msgstr "%1$s passt auf %2$s, aber nicht auf %3$s"

#. translators: 1: Pattern, 2: First matching path, 3: Second matching path.
#: admin/class-integrate-rybbit-admin.php:924
#, php-format
msgid "%1$s matches %2$s and %3$s"
msgstr "%1$s passt auf %2$s und %3$s"

#: admin/class-integrate-rybbit-admin.php:945
msgid "Mask patterns"
msgstr "Maskierungsmuster"

#: admin/class-integrate-rybbit-admin.php:949
msgid ""
"One pattern per line. Matching URL paths are tracked, but the recorded path "
"is replaced with the pattern (privacy masking)."
msgstr ""
"Ein Muster pro Zeile. Passende URL-Pfade werden getrackt, aber der "
"aufgezeichnete Pfad wird durch das Muster ersetzt (Datenschutz-Maskierung)."

#: admin/class-integrate-rybbit-admin.php:951
msgid "Example:"
msgstr "Beispiel:"

#. translators: 1: Pattern, 2: Visited path.
#: admin/class-integrate-rybbit-admin.php:955
#, php-format
msgid ""
"If you set %1$s and a user visits %2$s, analytics stores %1$s instead of the "
"real URL."
msgstr ""
"Bei der Einstellung %1$s und einem Besuch von %2$s speichert die Webanalyse "
"%1$s statt der echten URL."

#: admin/class-integrate-rybbit-admin.php:961
msgid "Wildcards and regular expressions work the same as in skip patterns."
msgstr ""
"Platzhalter und reguläre Ausdrücke funktionieren wie bei den "
"Ausschlussmustern."

#: admin/class-integrate-rybbit-admin.php:966
msgid "Debounce (ms)"
msgstr "Entprellung (ms)"

#: admin/class-integrate-rybbit-admin.php:979
msgid ""
"Delay before tracking a pageview after History API URL changes. Set to 0 to "
"disable."
msgstr ""
"Verzögerung, bevor ein Seitenaufruf nach URL-Änderungen über die History API "
"getrackt wird. Mit 0 deaktivieren."

#: admin/class-integrate-rybbit-admin.php:983
msgid "Tag"
msgstr "Tag"

#: admin/class-integrate-rybbit-admin.php:991
msgid "e.g. production"
msgstr "z. B. production"

#: admin/class-integrate-rybbit-admin.php:996
msgid ""
"Optional. Rybbit adds this tag to every event of this site. Use it to "
"separate environments or site versions. Maximum 256 characters."
msgstr ""
"Optional. Rybbit fügt dieses Tag jedem Event dieser Website hinzu. Damit "
"lassen sich Umgebungen oder Website-Versionen trennen. Maximal 256 Zeichen."

#: admin/class-integrate-rybbit-admin.php:1001
msgid ""
"Outbound link tracking, error tracking, Web Vitals, session replay and hash "
"routing are turned on or off per site in the Rybbit dashboard."
msgstr ""
"Tracking ausgehender Links, Fehler-Tracking, Web Vitals, Session Replay und "
"Hash-Routing werden pro Website im Rybbit-Dashboard ein- oder ausgeschaltet."

#. translators: %s: Rybbit function name.
#: admin/class-integrate-rybbit-admin.php:1016
#, php-format
msgid ""
"Send a custom event to Rybbit when a visitor clicks an element. The plugin "
"calls %s for you. You do not need to write JavaScript."
msgstr ""
"Sendet ein eigenes Event an Rybbit, wenn ein Besucher auf ein Element "
"klickt. Das Plugin ruft dafür %s auf. JavaScript muss nicht geschrieben "
"werden."

#: admin/class-integrate-rybbit-admin.php:1022
msgid "No event rules yet."
msgstr "Noch keine Event-Regeln."

#: admin/class-integrate-rybbit-admin.php:1031
msgid "Add event rule"
msgstr "Event-Regel hinzufügen"

#. translators: %d: Maximum number of rules.
#: admin/class-integrate-rybbit-admin.php:1042
#, php-format
msgid ""
"You can add up to %d rules. A rule also matches when the visitor clicks "
"inside a matching element, for example on an icon in a button. Visitors with "
"an excluded role do not send events."
msgstr ""
"Es sind bis zu %d Regeln möglich. Eine Regel greift auch, wenn der Besucher "
"in ein passendes Element klickt, zum Beispiel auf ein Icon in einer "
"Schaltfläche. Besucher mit einer ausgeschlossenen Rolle senden keine Events."

#. translators: 1: HTML attribute name, 2: HTML attribute name.
#: admin/class-integrate-rybbit-admin.php:1051
#, php-format
msgid ""
"You can also mark elements in your HTML with the %1$s and %2$s attributes. "
"Rybbit reads them without this plugin."
msgstr ""
"Elemente im HTML lassen sich auch mit den Attributen %1$s und %2$s "
"markieren. Rybbit liest sie auch ohne dieses Plugin."

#: admin/class-integrate-rybbit-admin.php:1085
msgid "CSS selector"
msgstr "CSS-Selektor"

#: admin/class-integrate-rybbit-admin.php:1089
msgid "Event name"
msgstr "Eventname"

#: admin/class-integrate-rybbit-admin.php:1093
msgid "Properties (optional)"
msgstr "Eigenschaften (optional)"

#: admin/class-integrate-rybbit-admin.php:1095
msgid ""
"One key=value pair per line. Values are sent as text. Maximum 2 KB in total."
msgstr ""
"Ein key=value-Paar pro Zeile. Werte werden als Text gesendet. Insgesamt "
"maximal 2 KB."

#: admin/class-integrate-rybbit-admin.php:1098
msgid "Remove rule"
msgstr "Regel entfernen"

#: admin/class-integrate-rybbit-admin.php:1108
msgid ""
"These options only apply when session replay is turned on for this site in "
"the Rybbit dashboard."
msgstr ""
"Diese Optionen gelten nur, wenn Session Replay für diese Website im Rybbit-"
"Dashboard eingeschaltet ist."

#: admin/class-integrate-rybbit-admin.php:1111
msgid "Mask text selectors"
msgstr "Selektoren für Textmaskierung"

#. translators: 1: Example selector, 2: Example selector.
#: admin/class-integrate-rybbit-admin.php:1118
#, php-format
msgid ""
"One CSS selector per line. Text content of matching elements is masked in "
"session replays. Example: %1$s or %2$s."
msgstr ""
"Ein CSS-Selektor pro Zeile. Der Textinhalt passender Elemente wird in "
"Session Replays maskiert. Beispiel: %1$s oder %2$s."

#. translators: %s: Default CSS class.
#: admin/class-integrate-rybbit-admin.php:1128
msgid "Block class"
msgstr "Block-Klasse"

#. translators: %s: Default CSS class.
#: admin/class-integrate-rybbit-admin.php:1128
#, php-format
msgid "Elements with this CSS class are not recorded at all. Default: %s"
msgstr ""
"Elemente mit dieser CSS-Klasse werden überhaupt nicht aufgezeichnet. "
"Standard: %s"

#: admin/class-integrate-rybbit-admin.php:1129
msgid "Block selector"
msgstr "Block-Selektor"

#: admin/class-integrate-rybbit-admin.php:1129
msgid "CSS selector for elements to exclude entirely from recording."
msgstr ""
"CSS-Selektor für Elemente, die vollständig von der Aufzeichnung "
"ausgeschlossen werden."

#. translators: %s: Default CSS class.
#: admin/class-integrate-rybbit-admin.php:1131
msgid "Ignore class"
msgstr "Ignorieren-Klasse"

#. translators: %s: Default CSS class.
#: admin/class-integrate-rybbit-admin.php:1131
#, php-format
msgid ""
"Elements with this CSS class appear in the replay, but their interactions "
"are not recorded. Default: %s"
msgstr ""
"Elemente mit dieser CSS-Klasse erscheinen im Replay, ihre Interaktionen "
"werden aber nicht aufgezeichnet. Standard: %s"

#: admin/class-integrate-rybbit-admin.php:1132
msgid "Ignore selector"
msgstr "Ignorieren-Selektor"

#: admin/class-integrate-rybbit-admin.php:1132
msgid "CSS selector for inputs and elements whose events are ignored."
msgstr ""
"CSS-Selektor für Eingabefelder und Elemente, deren Events ignoriert werden."

#. translators: %s: Default CSS class.
#: admin/class-integrate-rybbit-admin.php:1134
msgid "Mask text class"
msgstr "Textmaskierungs-Klasse"

#. translators: %s: Default CSS class.
#: admin/class-integrate-rybbit-admin.php:1134
#, php-format
msgid "Elements with this CSS class have their text masked. Default: %s"
msgstr ""
"Der Text von Elementen mit dieser CSS-Klasse wird maskiert. Standard: %s"

#: admin/class-integrate-rybbit-admin.php:1137
msgid "Mask all inputs"
msgstr "Alle Eingaben maskieren"

#: admin/class-integrate-rybbit-admin.php:1139
msgid "Mask all input values for privacy"
msgstr "Alle Eingabewerte aus Datenschutzgründen maskieren"

#: admin/class-integrate-rybbit-admin.php:1140
msgid "When enabled, session replay shows input values as asterisks."
msgstr "Wenn aktiviert, zeigt Session Replay Eingabewerte als Sternchen."

#: admin/class-integrate-rybbit-admin.php:1144
msgid "Mask input options (JSON)"
msgstr "Optionen für Eingabemaskierung (JSON)"

#. translators: %s: Example JSON.
#: admin/class-integrate-rybbit-admin.php:1152
#, php-format
msgid "JSON object that controls which input types are masked. Example: %s"
msgstr ""
"JSON-Objekt, das steuert, welche Eingabetypen maskiert werden. Beispiel: %s"

