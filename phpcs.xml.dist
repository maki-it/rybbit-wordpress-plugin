<?xml version="1.0"?>
<ruleset name="Integrate Rybbit">
	<description>Coding standard for the Integrate Rybbit plugin.</description>

	<file>./integrate-rybbit</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="integrate-rybbit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="integrate_rybbit"/>
				<element value="rybbit"/>
			</property>
		</properties>
	</rule>
</ruleset>
